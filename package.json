{
  "name": "god-is-bored-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:single": "tsc --noEmit && vite build -c vite.single.config.ts",
    "e2e": "node tools/e2e.cjs",
    "test:all": "vitest run && node tools/e2e.cjs",
    "e2e:human": "node tools/e2e-human.cjs",
    "dev:phone": "node tools/lan.mjs",
    "e2e:mobile": "node tools/e2e-mobile.cjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.0"
  }
}